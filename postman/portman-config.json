{
  "version": 1,
  "$schema": "https://raw.githubusercontent.com/apideck-libraries/portman/main/src/utils/portman-config-schema.json",
  "tests": {
    "contractTests": [
      {
        "openApiOperation": "*::/*",
        "statusSuccess": {
          "enabled": true
        }
      }
    ],
    "contentTests": [],
    "extendTests": [],
    "variationTests": []
  },
  "overwrites": [
    {
      "openApiOperation": "*::/*",
      "overwriteRequestSecurity": {
        "bearer": {
          "token": "{{accessToken}}"
        }
      }
    }
  ],
  "globals": {
    "collectionVariables": {
      "baseUrl": ""
    },
    "keyValueReplacements": {},
    "valueReplacements": {}
  }
}
