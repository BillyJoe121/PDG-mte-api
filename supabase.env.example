# Template only. Do not put real credentials in Git.
# PowerShell usage:
#   Get-Content .\supabase.env.example | ForEach-Object {
#     if ($_ -and -not $_.StartsWith('#')) {
#       $name, $value = $_.Split('=', 2)
#       [Environment]::SetEnvironmentVariable($name, $value, 'Process')
#     }
#   }

SPRING_PROFILES_ACTIVE=supabase
SUPABASE_DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=<supabase-database-password>
DB_DRIVER=org.postgresql.Driver
JPA_DDL_AUTO=validate
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false
MTE_SEED_ENABLED=true
MTE_AUTH_MODE=mock
# Habilitar solo después de registrar la aplicación en el proveedor institucional.
MTE_SSO_ENABLED=false
MTE_SSO_PROVIDER_NAME=ICESI
MTE_SSO_AUTHORIZATION_URI=https://<identity-provider>/authorize
MTE_SSO_TOKEN_URI=https://<identity-provider>/token
MTE_SSO_CLIENT_ID=<registered-client-id>
MTE_SSO_CLIENT_SECRET=<optional-server-side-secret>
MTE_SSO_REDIRECT_URI=http://localhost:5173/auth/callback
MTE_SSO_SCOPES=openid,profile,email
MTE_TRAYECTORIA_PROJECTS_MODE=mock
MTE_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200
